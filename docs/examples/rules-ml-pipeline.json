{
  "schema_version": "1.0",
  "spec_level": "L4",
  "l4": {
    "safety_cap_sec": 7200,
    "completion_confidence": 0.85,
    "tasks_coverage_pct": 95
  },
  "project": {
    "name": "fraud-detection-pipeline",
    "domain": "fintech-ml",
    "idea_summary": "Real-time fraud detection system using streaming transaction data, ensemble ML models, and an explainability layer for compliance"
  },
  "constraints": {
    "stack": {
      "backend": ["python", "fastapi", "kafka", "pytorch", "mlflow"],
      "frontend": ["react", "typescript"],
      "forbidden": ["spark_local_mode"]
    },
    "deployment": "local",
    "budget": "high",
    "timeline_weeks": 20
  },
  "nfr": {
    "latency_p95_ms": 50,
    "availability": "99.99%",
    "security": ["data_masking", "pii_protection", "audit_log", "rbac"]
  },
  "output": {
    "language": "en",
    "format": "markdown",
    "include_diagrams": true
  },
  "agent_rules": [
    {
      "id": "explainability",
      "priority": "critical",
      "rule": "Every model prediction must have an explainability output (SHAP or LIME) for compliance and dispute resolution"
    },
    {
      "id": "no_pii_in_model",
      "priority": "critical",
      "rule": "Raw PII must never enter model training; use tokenized and anonymized features only"
    },
    {
      "id": "streaming_first",
      "priority": "high",
      "rule": "Design for Kafka streaming; batch fallback is acceptable for training only"
    },
    {
      "id": "model_versioning",
      "priority": "high",
      "rule": "All models must be versioned in MLflow with full reproducibility metadata"
    },
    {
      "id": "false_negative_cost",
      "priority": "high",
      "rule": "Optimize for low false negative rate; false positives are more acceptable than missed fraud"
    },
    {
      "id": "ops_runbook",
      "priority": "medium",
      "rule": "Include operational runbooks for model retraining triggers and rollback procedures"
    }
  ],
  "ollama": {
    "llm_model": "llama3.2",
    "fallback_models": ["mistral", "qwen2.5:7b"],
    "embedding_model": "mxbai-embed-large",
    "embedding_fallback": "keyword",
    "temperature": 0.1,
    "max_tokens": 8192,
    "keep_alive": "10m",
    "timeout_sec": 180,
    "retry_on_error": 5,
    "retry_backoff_sec": [2, 5, 15, 30, 60]
  },
  "rag": {
    "enabled": true,
    "sources": ["./docs/domain"],
    "top_k": 12,
    "saturation": {
      "max_iterations": 7,
      "novelty_threshold": 0.12,
      "min_chunks": 20,
      "query_expansion": true
    }
  },
  "context": {
    "summarization_enabled": true,
    "max_raw_turns": 8,
    "compress_at_token_pct": 65
  },
  "monitoring": {
    "enabled": true,
    "interval_sec": 2,
    "warn_cpu_pct": 85,
    "warn_ram_pct": 80,
    "warn_gpu_mem_pct": 85,
    "show_per_core": true
  },
  "resilience": {
    "agent_timeout_sec": 900,
    "stuck_detection_sec": 450,
    "hitl_timeout_sec": 7200,
    "max_review_cycles": 15,
    "circuit_breaker_failures": 5,
    "circuit_breaker_cooldown_sec": 120,
    "checkpoint_every_agent": true,
    "auto_resume_on_reconnect": true
  }
}
