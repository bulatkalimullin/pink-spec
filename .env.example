# Pink Spec Agent — скопируй в .env и подстрой под себя
# cp .env.example .env

# ══════════════════════════════════════════════════════════════════════════════
# Зеркала сборки (Docker / make) — детали в mirrors.env
# ══════════════════════════════════════════════════════════════════════════════
DOCKER_MIRROR=dockerhub.timeweb.cloud
PYPI_MIRROR=https://pypi.tuna.tsinghua.edu.cn/simple
PYPI_MIRROR_FALLBACK=https://mirrors.aliyun.com/pypi/simple
PYTORCH_INDEX=https://download.pytorch.org/whl/cu124
NPM_REGISTRY=https://registry.npmmirror.com
NPM_REGISTRY_FALLBACK=https://mirrors.aliyun.com/npm/

# ══════════════════════════════════════════════════════════════════════════════
# Ollama — все LLM и embeddings (см. models/README.md)
# ══════════════════════════════════════════════════════════════════════════════
# Локально:  http://localhost:11434
# Docker + Ollama на хосте (snap): http://host.docker.internal:11435 (через ollama-proxy)
# Docker + Ollama в compose: http://ollama:11434  (make up-ollama-docker)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_PORT=11434

# Имена — точно как в `ollama list` (с namespace и тегом)
OLLAMA_LLM_MODEL=gemma3:4b
OLLAMA_LLM_FALLBACKS=gemma3:1b,qwen-uncensored-q4:latest
OLLAMA_EMBEDDING_MODEL=locusai/all-minilm-l6-v2:latest
# keyword | none — стратегия при сбое embeddings, НЕ имя модели
OLLAMA_EMBEDDING_FALLBACK=locusai/all-minilm-l6-v2:latest
OLLAMA_KEEP_ALIVE=5m
OLLAMA_TIMEOUT_SEC=300

# ══════════════════════════════════════════════════════════════════════════════
# Параметры генерации LLM
# L4 (Exhaustive): LLM_MAX_TOKENS≥8192, OLLAMA_TIMEOUT_SEC≥300, модель 7B+
# ══════════════════════════════════════════════════════════════════════════════
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=8192

# ══════════════════════════════════════════════════════════════════════════════
# Хранилище (в Docker пути переопределяются в docker-compose.yml)
# ══════════════════════════════════════════════════════════════════════════════
SQLITE_PATH=./data/pink_spec.db
VECTOR_PATH=./data/vectors
OUTPUT_PATH=./output

# ══════════════════════════════════════════════════════════════════════════════
# Порты сервисов
# ══════════════════════════════════════════════════════════════════════════════
BACKEND_PORT=8000
FRONTEND_PORT=3000

# ══════════════════════════════════════════════════════════════════════════════
# Мониторинг (дефолты; в сессии можно переопределить в rules.monitoring)
# ══════════════════════════════════════════════════════════════════════════════
MONITOR_INTERVAL_SEC=3
WARN_CPU_PCT=90
WARN_RAM_PCT=85
WARN_GPU_MEM_PCT=90

# ══════════════════════════════════════════════════════════════════════════════
# Устойчивость агентов (дефолты; в сессии — rules.resilience)
# ══════════════════════════════════════════════════════════════════════════════
AGENT_TIMEOUT_SEC=900
STUCK_DETECTION_SEC=600
HITL_TIMEOUT_SEC=7200

# ══════════════════════════════════════════════════════════════════════════════
# Docker GPU (ollama + backend system metrics via pynvml)
# Требуется nvidia-container-toolkit на хосте
# ══════════════════════════════════════════════════════════════════════════════
DOCKER_GPU_RUNTIME=nvidia
NVIDIA_VISIBLE_DEVICES=all
